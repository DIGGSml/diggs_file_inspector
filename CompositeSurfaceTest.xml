<?xml version="1.0" encoding="utf-8"?>
<!--
  CompositeSurfaceTest.xml — Phase 1.6 formal fixture (ERT_2D-3D handoff doc,
  snippets and plan docs/ERT_2D-3D_handoff_2026-08-05.md, §8 Phase 1).

  ****************************************************************************
  * VALIDATES CLEAN as of 2026-08-06 — Phase 2 schema changes landed in      *
  * ../diggs-schema (see snippets and plan docs/                            *
  * Phase2_schema_changes_2026-08-05.md). This file was authored in Phase 1 *
  * (2026-08-05) AHEAD OF the schema change it targets, as a knowing,       *
  * documented exception to "validate after every meaningful chunk" (the    *
  * viewer itself never validates against the XSD, so this was safe to      *
  * build ahead) — kept, not rewritten, as the permanent regression fixture *
  * for CompositeSurface/MultiSurface: run xmllint (noout, schema=          *
  * ../diggs-schema/Diggs.xsd) against this file from the repo root.        *
  * The cst-href-reuse case's xlink:href member was moved from inside       *
  * <surfaceMembers> to the new singular <surfaceMember> sibling during     *
  * Phase 2 verification — the file predated that design detail (settled   *
  * only once the singular property type was actually drafted).            *
  ****************************************************************************

  Covers all five items from the handoff doc's Phase 1.6 scope, one per
  samplingFeature below:
    1. cst-dogleg      — diggs:CompositeSurface, TWO INLINE members, each its
                          own LocalCartesianCRS (a real dog-leg trench wall —
                          see "REAL DATA" note below).
    2. cst-href-reuse  — diggs:CompositeSurface with ONE inline member PLUS
                          ONE xlink:href member reusing cst-dogleg's own
                          Patch 1 panel by reference (the actual benefit
                          CompositeSurface adds over MultiPlanarSurface's
                          patches — see handoff doc §4b).
    3. cst-inherit-srs — diggs:CompositeSurface whose WRAPPER carries its own
                          srsName; its one member carries NONE at all, and
                          must inherit the wrapper's (Phase 1.3's ancestor
                          walk) rather than falling through to the SF's own
                          referencePoint CRS.
    4. ms-disjoint     — diggs:MultiSurface of FOUR genuinely non-contiguous
                          inline members (small isolated footings, in the
                          style of RigidInclusions3.xml's real
                          ps-zone-bif-1..5 Geosynthetic zone — see handoff
                          doc §4c) — the case diggs:MultiPlanarSurface's own
                          "single contiguous surface" contract forbids.

  REAL DATA, not invented: cst-dogleg's two members, and the two
  LocalCartesianCRS objects they reference (dogleg-patch1-crs /
  dogleg-patch2-crs), are copied verbatim from TrenchWall3.xml's own
  "dogleg1" TrenchWall (its MultiPlanarSurface + PlanarSurfacePatch
  srsDimension/srsName hack — the exact thing Phase 2 §2.1 reverts). This
  file shows what that SAME real geometry looks like the CORRECT way — one
  PlanarSurface per patch, each with its own gml:id and srsName, wrapped in
  surfaceMember — i.e. this fixture doubles as a concrete preview of
  TrenchWall3.xml's own eventual Phase 3 conversion (handoff doc §8 Phase 3
  table). Patch 2's posList still carries Patch 1's continuous chainage
  (48-85) via dogleg-patch2-crs's own X-axis originOffset — unchanged, since
  that's an unrelated 3.1-dev schema feature, not part of what's being
  reverted.
-->
<Diggs xmlns="http://diggsml.org/schemas/3" xmlns:diggs="http://diggsml.org/schemas/3"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:gml="http://www.opengis.net/gml/3.2"
  xsi:schemaLocation="http://diggsml.org/schemas/3 https://raw.githubusercontent.com/DIGGSml/schema-dev/refs/heads/3.1-dev/Diggs.xsd"
  gml:id="CompositeSurfaceTestDoc">

  <documentInformation>
    <DocumentInformation gml:id="d1">
      <creationDate>2026-08-05</creationDate>
      <effectiveDate>2026-08-05</effectiveDate>
      <author>
        <BusinessAssociate gml:id="a1">
          <gml:name>Phase 1.6 fixture author</gml:name>
        </BusinessAssociate>
      </author>

      <crs>
        <!-- Copied verbatim from TrenchWall3.xml's dogleg-patch1-crs. X-axis
             bearing 78 deg from North, D-axis depth downward. Origin at the
             DogLeg reference point (SW end of Patch 1). -->
        <LocalCartesianCRS gml:id="dogleg-patch1-crs">
          <gml:description>
            Two-dimensional local Cartesian coordinate reference system for Patch 1
            of the DogLeg Trench. The X-axis runs horizontally along the patch face
            (bearing 78 degrees from North), and the D-axis (depth) points vertically
            downward. Origin is at the reference point (SW end of Patch 1), ground
            elevation 6.2 m. Patch is 48 m long and reaches 5.2 m maximum depth.
          </gml:description>
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">
            dogleg-patch1-crs
          </gml:identifier>
          <gml:name>Local Coordinate System for DogLeg Trench Patch 1</gml:name>
          <gml:scope>Trench wall mapping and geological logging with 2D representation</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="dogleg-patch1-cs">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">
                dogleg-patch1-cartesian-cs
              </gml:identifier>
              <gml:name>DogLeg Patch 1 2D Cartesian CS</gml:name>
              <gml:remarks>
                Two-dimensional Cartesian coordinate system for Patch 1 with X along
                the patch (bearing 78 degrees) and D downward (depth from reference point)
              </gml:remarks>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="dogleg-p1-x-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-p1-x-horizontal</gml:identifier>
                  <gml:name>X - Horizontal Along Patch 1 (bearing 78 deg)</gml:name>
                  <gml:axisAbbrev>X</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">northeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="dogleg-p1-d-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-p1-d-depth</gml:identifier>
                  <gml:name>D - Depth Below Reference Point</gml:name>
                  <gml:axisAbbrev>D</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="dogleg-patch1-datum">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-patch1-datum-001</gml:identifier>
              <gml:name>DogLeg Trench Patch 1 Local Datum</gml:name>
              <gml:scope/>
              <gml:anchorDefinition>
                Origin at DogLeg Trench reference point, elevation 6.2 m NAVD88. Patch 1
                extends 48 m along a bearing of 78 degrees to the junction with Patch 2 at
                elevation 4.8 m, reaching a maximum trench depth of 5.2 m (elevation 1.0 m).
              </gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="dogleg-patch1-origin" srsDimension="3"
              srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:description>Origin (0,0) at DogLeg Trench reference point (SW end of Patch 1).</gml:description>
              <gml:pos>387516.6651 3742145.123 6.2</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation>
            <AxisLocation gml:id="dogleg-p1-x-axis-location">
              <axisRef xlink:href="#dogleg-p1-x-axis"/>
              <axisOrder>1</axisOrder>
              <directionVector>0.9781 0.2079 0.0</directionVector>
            </AxisLocation>
          </axisLocation>
          <axisLocation>
            <diggs:AxisLocation gml:id="dogleg-p1-d-axis-location">
              <axisRef xlink:href="#dogleg-p1-d-axis"/>
              <axisOrder>2</axisOrder>
              <directionVector>0.0 0.0 -1.0</directionVector>
            </diggs:AxisLocation>
          </axisLocation>
          <transformationMethod>affine</transformationMethod>
          <rotationAngle uom="dega">78.0</rotationAngle>
          <scaleFactor>1.0</scaleFactor>
          <transformationAccuracy uom="m">0.001</transformationAccuracy>
        </LocalCartesianCRS>
      </crs>

      <crs>
        <!-- Copied verbatim from TrenchWall3.xml's dogleg-patch2-crs. X-axis
             bearing 110 deg from North. originOffset=48 on the X axis keeps
             Patch 2's posList in the same continuous chainage as Patch 1
             (48-85), rather than resetting to a local 0-37 frame. -->
        <LocalCartesianCRS gml:id="dogleg-patch2-crs">
          <gml:description>
            Two-dimensional local Cartesian coordinate reference system for Patch 2
            of the DogLeg Trench. The X-axis runs horizontally along the patch face
            (bearing 110 degrees from North), and the D-axis (depth) points vertically
            downward. Origin is at the Patch 1/Patch 2 junction, ground elevation
            4.8 m. Patch is 37 m long and reaches 6.5 m maximum depth (below its own
            origin; -3.4 m absolute elevation). Local X-coordinates are expressed in
            a continuous chainage shared with Patch 1 via the X-axis AxisLocation's
            originOffset (48).
          </gml:description>
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">
            dogleg-patch2-crs
          </gml:identifier>
          <gml:name>Local Coordinate System for DogLeg Trench Patch 2</gml:name>
          <gml:scope>Trench wall mapping and geological logging with 2D representation</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="dogleg-patch2-cs">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">
                dogleg-patch2-cartesian-cs
              </gml:identifier>
              <gml:name>DogLeg Patch 2 2D Cartesian CS</gml:name>
              <gml:remarks>
                Two-dimensional Cartesian coordinate system for Patch 2 with X along
                the patch (bearing 110 degrees) and D downward (depth from junction point)
              </gml:remarks>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="dogleg-p2-x-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-p2-x-horizontal</gml:identifier>
                  <gml:name>X - Horizontal Along Patch 2 (bearing 110 deg)</gml:name>
                  <gml:axisAbbrev>X</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">southeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="dogleg-p2-d-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-p2-d-depth</gml:identifier>
                  <gml:name>D - Depth Below Junction Point</gml:name>
                  <gml:axisAbbrev>D</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="dogleg-patch2-datum">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dogleg-patch2-datum-001</gml:identifier>
              <gml:name>DogLeg Trench Patch 2 Local Datum</gml:name>
              <gml:scope/>
              <gml:anchorDefinition>
                Origin at the Patch 1/Patch 2 junction, elevation 4.8 m NAVD88. Patch 2
                extends 37 m along a bearing of 110 degrees to its east end at elevation 6.75 m,
                reaching a maximum trench depth of 6.5 m below origin (absolute elevation
                -3.4 m).
              </gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="dogleg-patch2-origin" srsDimension="3"
              srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:description>Origin (local X=48 after offset, D=0) at the Patch 1/Patch 2 junction (west end of Patch 2).</gml:description>
              <gml:pos>387563.6162 3742155.1028 4.8</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation>
            <AxisLocation gml:id="dogleg-p2-x-axis-location">
              <axisRef xlink:href="#dogleg-p2-x-axis"/>
              <axisOrder>1</axisOrder>
              <directionVector>0.9397 -0.3420 0.0</directionVector>
              <originOffset>48</originOffset>
            </AxisLocation>
          </axisLocation>
          <axisLocation>
            <diggs:AxisLocation gml:id="dogleg-p2-d-axis-location">
              <axisRef xlink:href="#dogleg-p2-d-axis"/>
              <axisOrder>2</axisOrder>
              <directionVector>0.0 0.0 -1.0</directionVector>
            </diggs:AxisLocation>
          </axisLocation>
          <transformationMethod>affine</transformationMethod>
          <rotationAngle uom="dega">110.0</rotationAngle>
          <scaleFactor>1.0</scaleFactor>
          <transformationAccuracy uom="m">0.001</transformationAccuracy>
        </LocalCartesianCRS>
      </crs>

    </DocumentInformation>
  </documentInformation>

  <project>
    <Project gml:id="p1">
      <gml:name>CompositeSurfaceTest fixture project</gml:name>
    </Project>
  </project>

  <!-- ============================================================
       CASE 1 + 3: diggs:CompositeSurface, TWO INLINE members, each its
       own LocalCartesianCRS (real dog-leg trench geometry — see the
       file banner's REAL DATA note).
       ============================================================ -->
  <samplingFeature>
    <PlanarSamplingFeature gml:id="cst-dogleg">
      <gml:description>
        DogLeg Trench, re-expressed as a diggs:CompositeSurface of two
        surfaceMember PlanarSurface panels (Patch 1 / Patch 2), each with its
        own gml:id and srsName — the Phase 2 replacement for
        TrenchWall3.xml's current MultiPlanarSurface + PlanarSurfacePatch +
        gml:SRSReferenceGroup hack. Same geometry, same two CRS objects
        (dogleg-patch1-crs / dogleg-patch2-crs), same bearings (78 / 110 deg).
      </gml:description>
      <gml:name>DogLeg Trench (CompositeSurface form)</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="cst-dogleg-rp" srsDimension="3"
          srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>387516.6651 3742145.123 6.2</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <CompositeSurface gml:id="cst-dogleg-extent">
          <gml:description>Two contiguous panels forming one dog-leg trench wall surface.</gml:description>
          <surfaceMembers>
            <PlanarSurface gml:id="cst-dogleg-patch1" srsDimension="2" srsName="#dogleg-patch1-crs">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList count="25">
                    0 0 6 0.025 12 0.35 18 0.675 24 0.7 30 0.725 36 1.05 42 1.375 48 1.4
                    48 5.2 4 5.2 3.5 5.1111 3 4.8889 2.5 4.6 2 4.3111 1.5 4.0889 1 4
                    0.9 3.888 0.8 3.584 0.65 2.873 0.5 2 0.35 1.127 0.2 0.416 0.1 0.112 0 0
                  </gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
            <PlanarSurface gml:id="cst-dogleg-patch2" srsDimension="2" srsName="#dogleg-patch2-crs">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList count="26">
                    48 0 53 -0.3986 58 -0.7056 63 -0.8913 68 -1.0087 73 -1.1568 78 -1.4141 81.5 -1.6647 85 -1.95
                    84 -1.6019 83 -0.6691 82 0.6815 81 2.2826 80 3.9674 79 5.5685 78 6.9191 77 7.8519 76 8.2
                    51 8.2 50.5 7.8741 50 7.0593 49.5 6 49 4.9407 48.5 4.1259 48 3.8 48 0
                  </gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
          </surfaceMembers>
        </CompositeSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <!-- ============================================================
       CASE 2: diggs:CompositeSurface, ONE inline member + ONE xlink:href
       member REUSING cst-dogleg-patch1 above by reference — the concrete
       benefit CompositeSurface adds over MultiPlanarSurface's patches (see
       handoff doc §4b: addressable, xlink-reusable members).
       ============================================================ -->
  <samplingFeature>
    <PlanarSamplingFeature gml:id="cst-href-reuse">
      <gml:description>
        A second surface that reuses cst-dogleg's own Patch 1 panel by
        reference (xlink:href="#cst-dogleg-patch1") alongside one inline
        member of its own — demonstrating that a panel authored once can be
        shared, which a bare inline PlanarSurfacePatch could never do.
      </gml:description>
      <gml:name>Href-reuse CompositeSurface test</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="cst-href-rp" srsDimension="3"
          srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>387600.0 3742200.0 6.2</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <CompositeSurface gml:id="cst-href-extent">
          <gml:description>One inline panel plus one panel reused from cst-dogleg by reference.</gml:description>
          <surfaceMember xlink:href="#cst-dogleg-patch1"/>
          <surfaceMembers>
            <PlanarSurface gml:id="cst-href-own-panel" srsDimension="2" srsName="#dogleg-patch1-crs">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>100 0 106 0 106 3 100 3 100 0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
          </surfaceMembers>
        </CompositeSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <!-- ============================================================
       CASE 3: diggs:CompositeSurface whose WRAPPER carries its own srsName
       (UTM 16N, a plain EPSG code directly on the wrapper — no
       LocalCartesianCRS indirection, matching Phase 1.3's own already-
       verified ad-hoc probe design exactly:
       snippets and plan docs/phase1_baseline/ancestor_srs_probe_adhoc.xml),
       DIFFERENT from this SF's own referencePoint CRS (UTM 15N, inline
       below). The one member below carries NO srsName/srsDimension of its
       own at all and must inherit the wrapper's (Phase 1.3's ancestor
       walk), not fall through to the SF's own CRS.
       ============================================================ -->
  <samplingFeature>
    <PlanarSamplingFeature gml:id="cst-inherit-srs">
      <gml:description>
        The wrapper's own srsName (UTM 16N) must be inherited by the member
        below, which declares none of its own — NOT the SF's own
        referencePoint CRS (UTM 15N). The two zones' central meridians are 6
        degrees of longitude apart for the same raw coordinates (both
        exactly on their own zone's central meridian, since 500000 is UTM's
        false easting), so a wrong CRS choice here is trivially visible:
        correct resolution puts this polygon's longitude at -87 (16N); the
        bug this fixture guards against would instead produce -93 (15N) —
        see Phase 1.3's own verification in the ERT_2D-3D handoff doc for
        the exact figures this reproduces.
      </gml:description>
      <gml:name>Ancestor srsName inheritance test</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="cst-inherit-rp" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/32615">
          <gml:pos>500000 3300000</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <CompositeSurface gml:id="cst-inherit-extent" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/32616">
          <gml:description>Wrapper declares its own CRS (UTM 16N); its member below does not.</gml:description>
          <surfaceMembers>
            <PlanarSurface gml:id="cst-inherit-member">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>500000 3300000 500010 3300000 500010 3300010 500000 3300010 500000 3300000</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
          </surfaceMembers>
        </CompositeSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <!-- ============================================================
       CASE 4: diggs:MultiSurface of FOUR genuinely non-contiguous inline
       members — small isolated footings, in the style of
       RigidInclusions3.xml's real Geosynthetic zone
       (featureExtent/MultiSurfaceAggregate/surfaceMembers/PlanarSurface
       ps-zone-bif-1..5 — see handoff doc §4c). This is the shape
       diggs:MultiPlanarSurface's own "single contiguous surface, each patch
       must share an edge with an adjacent patch" contract explicitly
       forbids — MultiSurface makes no such claim.
       ============================================================ -->
  <samplingFeature>
    <PlanarSamplingFeature gml:id="ms-disjoint">
      <gml:description>
        Four small, mutually non-adjacent square footings forming one
        MultiSurface extent — no two members share an edge, unlike
        MultiPlanarSurface's contiguous-patch contract.
      </gml:description>
      <gml:name>Disjoint MultiSurface test</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="ms-disjoint-rp" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/26911">
          <gml:pos>387700.0 3742300.0</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <MultiSurface gml:id="ms-disjoint-extent">
          <gml:description>Four disjoint footing polygons.</gml:description>
          <surfaceMembers>
            <PlanarSurface gml:id="ms-footing-1" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/26911">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>387700.0 3742300.0 387702.0 3742300.0 387702.0 3742302.0 387700.0 3742302.0 387700.0 3742300.0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
            <PlanarSurface gml:id="ms-footing-2" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/26911">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>387710.0 3742300.0 387712.0 3742300.0 387712.0 3742302.0 387710.0 3742302.0 387710.0 3742300.0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
            <PlanarSurface gml:id="ms-footing-3" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/26911">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>387700.0 3742310.0 387702.0 3742310.0 387702.0 3742312.0 387700.0 3742312.0 387700.0 3742310.0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
            <PlanarSurface gml:id="ms-footing-4" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/26911">
              <gml:exterior>
                <gml:LinearRing>
                  <gml:posList>387710.0 3742310.0 387712.0 3742310.0 387712.0 3742312.0 387710.0 3742312.0 387710.0 3742310.0</gml:posList>
                </gml:LinearRing>
              </gml:exterior>
            </PlanarSurface>
