<?xml version="1.0" encoding="utf-8"?>
<!--
  GridSectionTest.xml — synthetic fixture for the 2D grid-domain section
  renderer (ERT_2D-3D_handoff_2026-08-05.md Section 6, item 4 / "6.4").

  Two Test measurements, each a diggs:ReferenceableGridByArray domain
  (12 nodes / 4x3 and 9 nodes / 3x3), chosen to exercise the two CRS shapes
  the renderer's own projection hook (_gridLocalPlane) has to tell apart —
  see the "so be thinking about this" discussion in the same handoff
  session: a grid-domain measurement is not always already reported in a
  purpose-built local section CRS.

    1. Test-GRID-LOCAL: a LocalCartesianCRS vertical section (along-line,
       depth-down), the recommended ERT encoding (handoff Section 3) — this
       is the "no projection needed" case. Terrain-draped (per-column top
       depth varies) and non-uniform (deeper cell thicker) on purpose, to
       exercise the dual-mesh corner construction on a genuinely warped
       grid, not a trivial rectangle. Traversal order is Boustrophedonic
       (serpentine), not Linear, to also exercise that sequenceRule through
       the real render path rather than only the earlier parse-only probes.
    2. Test-GRID-GEO: a horizontal grid reported directly in EPSG:4326
       (geographic, lat/lon, no elevation component) — the case the
       renderer must reproject via coordsToLocalMeters() and orient
       north-up rather than assuming a local along-line/depth frame.

  Validates clean:
    xmllint (noout, schema=../diggs-schema/Diggs.xsd) GridSectionTest.xml
-->
<Diggs xmlns="http://diggsml.org/schemas/3" xmlns:diggs="http://diggsml.org/schemas/3"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:gml="http://www.opengis.net/gml/3.2"
  xsi:schemaLocation="http://diggsml.org/schemas/3 https://raw.githubusercontent.com/DIGGSml/schema-dev/refs/heads/3.1-dev/Diggs.xsd"
  gml:id="GridSectionTest">
  <documentInformation>
    <DocumentInformation gml:id="di1">
      <creationDate>2026-08-06</creationDate>
      <author><BusinessAssociate gml:id="ba-usgs"><gml:name>U.S. Geological Survey</gml:name></BusinessAssociate></author>
      <crs>
        <LocalCartesianCRS gml:id="crs-sec-KL05">
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">crs-sec-KL05</gml:identifier>
          <gml:name>Grid section plane, synthetic line</gml:name>
          <gml:scope>Synthetic ERT-style inverted resistivity section</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="cs-sec-KL05">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">cs-sec-KL05</gml:identifier>
              <gml:name>Section CS</gml:name>
              <gml:axis><gml:CoordinateSystemAxis gml:id="ax-KL05-x" uom="m">
                <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">ax-KL05-x</gml:identifier>
                <gml:name>X - along trackline</gml:name><gml:axisAbbrev>X</gml:axisAbbrev>
                <gml:axisDirection codeSpace="EPSG">northeast</gml:axisDirection></gml:CoordinateSystemAxis></gml:axis>
              <gml:axis><gml:CoordinateSystemAxis gml:id="ax-KL05-d" uom="m">
                <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">ax-KL05-d</gml:identifier>
                <gml:name>D - depth</gml:name><gml:axisAbbrev>D</gml:axisAbbrev>
                <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection></gml:CoordinateSystemAxis></gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="dat-sec-KL05">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dat-sec-KL05</gml:identifier>
              <gml:name>Origin at electrode 1</gml:name><gml:scope/>
              <gml:anchorDefinition>Ground surface at electrode 1.</gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="org-sec-KL05" srsDimension="3" srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/32615&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:pos>474655.883 3990117.630 249.998</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation><AxisLocation gml:id="axl-KL05-x"><axisRef xlink:href="#ax-KL05-x"/>
            <axisOrder>1</axisOrder><directionVector>0.9042216 0.4270636 0.0</directionVector></AxisLocation></axisLocation>
          <axisLocation><AxisLocation gml:id="axl-KL05-d"><axisRef xlink:href="#ax-KL05-d"/>
            <axisOrder>2</axisOrder><directionVector>0.0 0.0 -1.0</directionVector></AxisLocation></axisLocation>
          <transformationMethod>affine</transformationMethod>
          <scaleFactor>1.0</scaleFactor>
        </LocalCartesianCRS>
      </crs>
      <crs>
        <!-- Third CRS: a true 3-axis (X, Y, D) LocalCartesianCRS for the
             VolumetricSamplingFeature fixture below (a synthetic 3x3x3
             "Ozark-style" 3D array core, not a real dataset) — X/Y pure
             orthogonal horizontal directions (unlike crs-sec-KL05's bearing-
             rotated section X), D straight down, so the 3D volume renderer's
             own axis-orientation resolution (_gridLocalAxes3D) has a genuine
             3-axis local frame to read, distinct from the 2-axis section CRS
             above. -->
        <LocalCartesianCRS gml:id="crs-vol-OZK">
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">crs-vol-OZK</gml:identifier>
          <gml:name>3D volume grid frame, synthetic array</gml:name>
          <gml:scope>Synthetic 3D electrode-array inversion volume</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="cs-vol-OZK">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">cs-vol-OZK</gml:identifier>
              <gml:name>Volume CS</gml:name>
              <gml:axis><gml:CoordinateSystemAxis gml:id="ax-OZK-x" uom="m">
                <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">ax-OZK-x</gml:identifier>
                <gml:name>X - array east</gml:name><gml:axisAbbrev>X</gml:axisAbbrev>
                <gml:axisDirection codeSpace="EPSG">east</gml:axisDirection></gml:CoordinateSystemAxis></gml:axis>
              <gml:axis><gml:CoordinateSystemAxis gml:id="ax-OZK-y" uom="m">
                <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">ax-OZK-y</gml:identifier>
                <gml:name>Y - array north</gml:name><gml:axisAbbrev>Y</gml:axisAbbrev>
                <gml:axisDirection codeSpace="EPSG">north</gml:axisDirection></gml:CoordinateSystemAxis></gml:axis>
              <gml:axis><gml:CoordinateSystemAxis gml:id="ax-OZK-d" uom="m">
                <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">ax-OZK-d</gml:identifier>
                <gml:name>D - depth</gml:name><gml:axisAbbrev>D</gml:axisAbbrev>
                <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection></gml:CoordinateSystemAxis></gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="dat-vol-OZK">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">dat-vol-OZK</gml:identifier>
              <gml:name>Origin at array corner electrode</gml:name><gml:scope/>
              <gml:anchorDefinition>Ground surface at array corner electrode.</gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="org-vol-OZK" srsDimension="3" srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/32615&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:pos>475200.000 3990500.000 245.000</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation><AxisLocation gml:id="axl-OZK-x"><axisRef xlink:href="#ax-OZK-x"/>
            <axisOrder>1</axisOrder><directionVector>1.0 0.0 0.0</directionVector></AxisLocation></axisLocation>
          <axisLocation><AxisLocation gml:id="axl-OZK-y"><axisRef xlink:href="#ax-OZK-y"/>
            <axisOrder>2</axisOrder><directionVector>0.0 1.0 0.0</directionVector></AxisLocation></axisLocation>
          <axisLocation><AxisLocation gml:id="axl-OZK-d"><axisRef xlink:href="#ax-OZK-d"/>
            <axisOrder>3</axisOrder><directionVector>0.0 0.0 -1.0</directionVector></AxisLocation></axisLocation>
          <transformationMethod>affine</transformationMethod>
          <scaleFactor>1.0</scaleFactor>
        </LocalCartesianCRS>
      </crs>
    </DocumentInformation>
  </documentInformation>

  <project><Project gml:id="proj-GRIDTEST"><gml:name>Grid Section Renderer Test</gml:name></Project></project>

  <samplingFeature>
    <PlanarSamplingFeature gml:id="SEC-LOCAL">
      <gml:name>Synthetic local-CRS resistivity section</gml:name>
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <referencePoint>
        <PointLocation gml:id="rp-SEC-LOCAL" srsDimension="3" srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/32615&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>474655.883 3990117.630 249.998</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <PlanarSurface gml:id="fe-SEC-LOCAL" srsDimension="2" srsName="#crs-sec-KL05">
          <gml:exterior><gml:LinearRing><gml:posList>0 0 15 0 15 8 0 8 0 0</gml:posList></gml:LinearRing></gml:exterior>
        </PlanarSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <samplingFeature>
    <PlanarSamplingFeature gml:id="SEC-GEO">
      <gml:name>Synthetic geographic-CRS magnetics survey</gml:name>
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <referencePoint>
        <PointLocation gml:id="rp-SEC-GEO" srsDimension="3" srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/32615&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>474700.0 3990160.0 250.0</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <PlanarSurface gml:id="fe-SEC-GEO" srsDimension="2" srsName="#crs-sec-KL05">
          <gml:exterior><gml:LinearRing><gml:posList>20 0 30 0 30 6 20 6 20 0</gml:posList></gml:LinearRing></gml:exterior>
        </PlanarSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <samplingFeature>
    <VolumetricSamplingFeature gml:id="VOL-OZK">
      <gml:name>Synthetic 3D array inversion volume</gml:name>
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <referencePoint>
        <PointLocation gml:id="rp-VOL-OZK" srsDimension="3" srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/32615&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>475200.000 3990500.000 245.000</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <!-- exterior is minOccurs=0 on AbstractVolumeType — a bare Solid with
             no boundary is schema-valid and sufficient here; this fixture's
             job is to exercise the grid-domain 3D renderer, not the (still
             unvalidated, per CLAUDE.md) Solid ring-extraction path. -->
        <Solid gml:id="fe-VOL-OZK"/>
      </featureExtent>
    </VolumetricSamplingFeature>
  </samplingFeature>

  <measurement>
    <Test gml:id="Test-GRID-LOCAL">
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <samplingFeatureRef xlink:href="#SEC-LOCAL"/>
      <outcome>
        <TestResult gml:id="tr-GRID-LOCAL">
          <location>
            <ReferenceableGridByArray gml:id="grid-LOCAL" srsDimension="2" srsName="#crs-sec-KL05" dimension="2">
              <limits><gml:GridEnvelope><gml:low>0 0</gml:low><gml:high>3 2</gml:high></gml:GridEnvelope></limits>
              <axisLabels>i j</axisLabels>
              <gml:posList>0 0.3 0 2.8 0 6.8 5 7.1 5 3.1 5 0.6 10 0.2 10 2.7 10 6.7 15 7.0 15 3.0 15 0.5</gml:posList>
              <sequenceRule axisOrder="+1 +2">Boustrophedonic</sequenceRule>
            </ReferenceableGridByArray>
          </location>
          <results>
            <ResultSet>
              <parameters><PropertyParameters gml:id="pp-GRID-LOCAL"><properties>
                <Property index="1">
                  <propertyName>Resistivity</propertyName>
                  <typeData>double</typeData>
                  <propertyClass codeSpace="https://diggsml.org/def/codes/DIGGS/0.1/gp_properties.xml">electrical resistivity</propertyClass>
                  <uom>ohm.m</uom>
                </Property>
                <Property index="2">
                  <propertyName>Chargeability</propertyName>
                  <typeData>double</typeData>
                  <propertyClass codeSpace="https://diggsml.org/def/codes/DIGGS/0.1/gp_properties.xml">chargeability</propertyClass>
                  <uom>%</uom>
                </Property>
              </properties></PropertyParameters></parameters>
              <!-- Two properties per node (ts/cs override the default
                   whitespace/comma split so "resistivity chargeability"
                   pairs, one row per line, parse unambiguously) — added to
                   exercise the multi-property-per-node case: the grid
                   section renderer must produce one stacked heatmap+legend
                   block per drawable property, same "one plot per column"
                   convention drawResultPlots already uses for a depth/time
                   profile with more than one reported property. -->
              <dataValues ts="&#10;" cs=" ">
850 8.2
400 12.5
150 22.1
180 20.3
420 11.8
900 7.5
1200 6.1
500 10.9
200 19.4
190 21.0
410 12.0
880 7.8
              </dataValues>
            </ResultSet>
          </results>
        </TestResult>
      </outcome>
      <procedure>
        <GeophysicalProcessing gml:id="gp-GRID-LOCAL">
          <gml:description>Synthetic Occam-style inversion result for renderer testing.</gml:description>
          <geophysicalMethod>electrical resistivity tomography (ERT)</geophysicalMethod>
        </GeophysicalProcessing>
      </procedure>
    </Test>
  </measurement>

  <measurement>
    <Test gml:id="Test-GRID-GEO">
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <samplingFeatureRef xlink:href="#SEC-GEO"/>
      <outcome>
        <TestResult gml:id="tr-GRID-GEO">
          <location>
            <ReferenceableGridByArray gml:id="grid-GEO" srsDimension="2" srsName="http://www.opengis.net/def/crs/EPSG/0/4326" dimension="2">
              <limits><gml:GridEnvelope><gml:low>0 0</gml:low><gml:high>2 2</gml:high></gml:GridEnvelope></limits>
              <axisLabels>lat lon</axisLabels>
              <gml:posList>39.000 -106.000 39.000 -105.999 39.000 -105.998 39.001 -106.000 39.001 -105.999 39.001 -105.998 39.002 -106.000 39.002 -105.999 39.002 -105.998</gml:posList>
              <sequenceRule>Linear</sequenceRule>
            </ReferenceableGridByArray>
          </location>
          <results>
            <ResultSet>
              <parameters><PropertyParameters gml:id="pp-GRID-GEO"><properties>
                <Property index="1">
                  <propertyName>MagField</propertyName>
                  <typeData>double</typeData>
                  <propertyClass codeSpace="https://diggsml.org/def/codes/DIGGS/0.1/gp_properties.xml">magnetic field strength</propertyClass>
                  <uom>nT</uom>
                </Property>
              </properties></PropertyParameters></parameters>
              <dataValues>
                51000 51050 51100 51200 51150 51080 51300 51250 51180
              </dataValues>
            </ResultSet>
          </results>
        </TestResult>
      </outcome>
      <procedure>
        <GeophysicalProcessing gml:id="gp-GRID-GEO">
          <gml:description>Synthetic magnetometry survey result for renderer testing (geographic CRS, no local section frame).</gml:description>
          <geophysicalMethod>magnetometry</geophysicalMethod>
        </GeophysicalProcessing>
      </procedure>
    </Test>
  </measurement>

  <measurement>
    <!-- Test-GRID-VOL: a genuinely 3D (dims.length===3) ReferenceableGridByArray
         domain, for the 3D volume renderer (point cloud + orthogonal I/J/K
         slice planes — ERT_2D-3D_handoff_2026-08-05.md Section 6 item 5,
         the "Ozark 3D volume" half only, not the fence-diagram half). 3x3x3
         = 27 nodes in crs-vol-OZK (a true 3-axis LocalCartesianCRS, D axis
         down-positive) — mildly terrain-warped on D (not a perfect
         rectilinear lattice) to exercise real node positions rather than an
         idealized cube. Traversal is Linear with axisOrder="+1 +2 +3" (D,
         the last-listed axis, varies fastest) — i.e. posList is ordered
         X outer / Y middle / D inner. -->
    <Test gml:id="Test-GRID-VOL">
      <projectRef xlink:href="#proj-GRIDTEST"/>
      <samplingFeatureRef xlink:href="#VOL-OZK"/>
      <outcome>
        <TestResult gml:id="tr-GRID-VOL">
          <location>
            <ReferenceableGridByArray gml:id="grid-VOL" srsDimension="3" srsName="#crs-vol-OZK" dimension="3">
              <limits><gml:GridEnvelope><gml:low>0 0 0</gml:low><gml:high>2 2 2</gml:high></gml:GridEnvelope></limits>
              <axisLabels>x y d</axisLabels>
              <gml:posList>0 0 0.00 0 0 5.00 0 0 10.00 0 5 -0.30 0 5 4.70 0 5 9.70 0 10 -0.60 0 10 4.40 0 10 9.40 5 0 0.30 5 0 5.30 5 0 10.30 5 5 0.00 5 5 5.00 5 5 10.00 5 10 -0.30 5 10 4.70 5 10 9.70 10 0 0.60 10 0 5.60 10 0 10.60 10 5 0.30 10 5 5.30 10 5 10.30 10 10 0.00 10 10 5.00 10 10 10.00</gml:posList>
              <sequenceRule axisOrder="+1 +2 +3">Linear</sequenceRule>
            </ReferenceableGridByArray>
          </location>
          <results>
            <ResultSet>
              <parameters><PropertyParameters gml:id="pp-GRID-VOL"><properties>
                <Property index="1">
                  <propertyName>Resistivity</propertyName>
                  <typeData>double</typeData>
                  <propertyClass codeSpace="https://diggsml.org/def/codes/DIGGS/0.1/gp_properties.xml">electrical resistivity</propertyClass>
                  <uom>ohm.m</uom>
                </Property>
              </properties></PropertyParameters></parameters>
              <dataValues>100 160 220 115 175 235 130 190 250 130 190 250 145 205 265 160 220 280 160 220 280 175 235 295 190 250 310</dataValues>
            </ResultSet>
          </results>
        </TestResult>
      </outcome>
      <procedure>
        <GeophysicalProcessing gml:id="gp-GRID-VOL">
          <gml:description>Synthetic 3D-array Occam-style inversion volume for the 3D grid renderer test.</gml:description>
          <geophysicalMethod>electrical resistivity tomography (ERT)</geophysicalMethod>
        </GeophysicalProcessing>
      </procedure>
    </Test>
  </measurement>
</Diggs>
