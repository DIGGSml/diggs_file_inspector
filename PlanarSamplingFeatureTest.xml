<?xml version="1.0" encoding="utf-8"?>
<Diggs xmlns="http://diggsml.org/schemas/3" xmlns:diggs="http://diggsml.org/schemas/3"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:glr="http://www.opengis.net/gml/3.3/lr"
  xsi:schemaLocation="http://diggsml.org/schemas/3 https://raw.githubusercontent.com/DIGGSml/schema-dev/refs/heads/3.1-dev/Diggs.xsd"
  gml:id="PlanarSamplingFeatureTestDoc">
  <documentInformation>
    <DocumentInformation gml:id="d1">
      <creationDate>2026-07-09</creationDate>
      <effectiveDate>2026-07-09</effectiveDate>
      <author>
        <BusinessAssociate gml:id="a1">
          <gml:name>Test Author</gml:name>
        </BusinessAssociate>
      </author>
      <crs>
        <LocalCartesianCRS gml:id="psf-2d-crs-001">
          <gml:description>
            Local Cartesian CRS used to test PlanarSamplingFeature polygon rendering.
            The X (strike) axis runs along a bearing of 45 degrees (northeast) from
            north. The D (dip) axis is perpendicular to X in the horizontal plane
            (bearing 135 degrees, southeast — strike bearing + 90) and dips 60
            degrees from horizontal, rather than running straight down — this
            keeps the two axes orthogonal (required for a Cartesian CS) while
            still giving the surface a horizontal footprint, so it should render
            as a foreshortened polygon rather than collapsing to a line when
            projected onto the map.
          </gml:description>
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-crs-001</gml:identifier>
          <gml:name>Local Coordinate System for PlanarSamplingFeature test</gml:name>
          <gml:scope>Testing polygon rendering for PlanarSamplingFeature</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="psf-2d-cs">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-cartesian-cs</gml:identifier>
              <gml:name>PSF 2D Cartesian CS</gml:name>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-x-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-x-horizontal</gml:identifier>
                  <gml:name>X - Horizontal</gml:name>
                  <gml:axisAbbrev>X</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">northeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-d-axis" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-d-depth</gml:identifier>
                  <gml:name>D - Depth</gml:name>
                  <gml:axisAbbrev>D</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="psf-2d-datum">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-datum-001</gml:identifier>
              <gml:name>PSF 2D Local Datum</gml:name>
              <gml:scope/>
              <gml:anchorDefinition>Origin at top southwest corner of the test surface.</gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="psf-2d-origin" srsDimension="3"
              srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:pos>387600.0 3742700.0 5.0</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation>
            <AxisLocation gml:id="psf-x-axis-location">
              <axisRef xlink:href="#psf-x-axis"/>
              <axisOrder>1</axisOrder>
              <!-- Bearing 45 deg (NE) from north: easting component =
                   sin(45deg), northing component = cos(45deg). -->
              <directionVector>0.7071068 0.7071068 0.0</directionVector>
            </AxisLocation>
          </axisLocation>
          <axisLocation>
            <diggs:AxisLocation gml:id="psf-d-axis-location">
              <axisRef xlink:href="#psf-d-axis"/>
              <axisOrder>2</axisOrder>
              <!-- Dip direction must stay horizontally perpendicular to the X
                   (strike) axis for the CS to remain orthogonal — bearing
                   45+90=135 deg (SE), then tilted 60 deg from horizontal:
                   easting = cos(60deg)*sin(135deg), northing = cos(60deg)*cos(135deg),
                   vertical = -sin(60deg). -->
              <directionVector>0.3535534 -0.3535534 -0.8660254</directionVector>
            </diggs:AxisLocation>
          </axisLocation>
          <transformationMethod>affine</transformationMethod>
          <rotationAngle uom="dega">45.0</rotationAngle>
          <scaleFactor>1.0</scaleFactor>
          <transformationAccuracy uom="m">0.001</transformationAccuracy>
        </LocalCartesianCRS>
      </crs>
      <crs>
        <LocalCartesianCRS gml:id="psf-2d-crs-002">
          <gml:description>
            Second test CRS, origin 100 m south of psf-2d-crs-001. Same X
            (strike) axis bearing (45 deg, NE) as psf-2d-crs-001, but the D
            axis is fully horizontal (dip 0 deg from horizontal) rather than
            dipping — it simply extends southeast (bearing 135 deg, still
            perpendicular to X so the CS stays orthogonal). Tests a flat
            (non-dipping) planar surface: the rendered polygon should show
            its full, undistorted extent (no foreshortening from Z-drop),
            unlike psf-2d-crs-001's foreshortened dip surface.
          </gml:description>
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-crs-002</gml:identifier>
          <gml:name>Local Coordinate System for PlanarSamplingFeature test 2 (horizontal)</gml:name>
          <gml:scope>Testing polygon rendering for PlanarSamplingFeature</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="psf-2d-cs-2">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-cartesian-cs-2</gml:identifier>
              <gml:name>PSF 2D Cartesian CS 2</gml:name>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-x-axis-2" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-x-horizontal-2</gml:identifier>
                  <gml:name>X - Horizontal</gml:name>
                  <gml:axisAbbrev>X</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">northeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-d-axis-2" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-d-depth-2</gml:identifier>
                  <gml:name>D - Depth</gml:name>
                  <gml:axisAbbrev>D</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">southeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="psf-2d-datum-2">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-datum-002</gml:identifier>
              <gml:name>PSF 2D Local Datum 2</gml:name>
              <gml:scope/>
              <gml:anchorDefinition>Origin at top southwest corner of the test surface, 100 m south of psf-2d-crs-001's origin.</gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="psf-2d-origin-2" srsDimension="3"
              srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:pos>387600.0 3742600.0 5.0</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation>
            <AxisLocation gml:id="psf-x-axis-location-2">
              <axisRef xlink:href="#psf-x-axis-2"/>
              <axisOrder>1</axisOrder>
              <!-- Bearing 45 deg (NE) from north, same as psf-2d-crs-001. -->
              <directionVector>0.7071068 0.7071068 0.0</directionVector>
            </AxisLocation>
          </axisLocation>
          <axisLocation>
            <diggs:AxisLocation gml:id="psf-d-axis-location-2">
              <axisRef xlink:href="#psf-d-axis-2"/>
              <axisOrder>2</axisOrder>
              <!-- Fully horizontal (dip 0 deg): bearing 135 deg (SE), still
                   perpendicular to X so the CS stays orthogonal, but no
                   vertical component. -->
              <directionVector>0.7071068 -0.7071068 0.0</directionVector>
            </diggs:AxisLocation>
          </axisLocation>
          <transformationMethod>affine</transformationMethod>
          <rotationAngle uom="dega">45.0</rotationAngle>
          <scaleFactor>1.0</scaleFactor>
          <transformationAccuracy uom="m">0.001</transformationAccuracy>
        </LocalCartesianCRS>
      </crs>
      <crs>
        <LocalCartesianCRS gml:id="psf-2d-crs-003">
          <gml:description>
            Third test CRS, origin 100 m south of psf-2d-crs-002 (200 m south
            of psf-2d-crs-001). Same X (strike) axis bearing (45 deg, NE) as
            the other two test CRSs, but the D axis is fully vertical (dip 90
            deg from horizontal, straight down) — the original TrenchWall-like
            case. Since D contributes no horizontal component, the rendered
            polygon should collapse to a line when Z is dropped for the map,
            unlike psf-2d-crs-001 (foreshortened) and psf-2d-crs-002 (full
            extent).
          </gml:description>
          <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-crs-003</gml:identifier>
          <gml:name>Local Coordinate System for PlanarSamplingFeature test 3 (vertical)</gml:name>
          <gml:scope>Testing polygon rendering for PlanarSamplingFeature</gml:scope>
          <gml:cartesianCS>
            <gml:CartesianCS gml:id="psf-2d-cs-3">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-cartesian-cs-3</gml:identifier>
              <gml:name>PSF 2D Cartesian CS 3</gml:name>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-x-axis-3" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-x-horizontal-3</gml:identifier>
                  <gml:name>X - Horizontal</gml:name>
                  <gml:axisAbbrev>X</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">northeast</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
              <gml:axis>
                <gml:CoordinateSystemAxis gml:id="psf-d-axis-3" uom="m">
                  <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-d-depth-3</gml:identifier>
                  <gml:name>D - Depth</gml:name>
                  <gml:axisAbbrev>D</gml:axisAbbrev>
                  <gml:axisDirection codeSpace="EPSG">down</gml:axisDirection>
                </gml:CoordinateSystemAxis>
              </gml:axis>
            </gml:CartesianCS>
          </gml:cartesianCS>
          <gml:engineeringDatum>
            <gml:EngineeringDatum gml:id="psf-2d-datum-3">
              <gml:identifier codeSpace="http://diggsml.org/def/authorities.xml#DIGGS">psf-2d-datum-003</gml:identifier>
              <gml:name>PSF 2D Local Datum 3</gml:name>
              <gml:scope/>
              <gml:anchorDefinition>Origin at top southwest corner of the test surface, 200 m south of psf-2d-crs-001's origin.</gml:anchorDefinition>
            </gml:EngineeringDatum>
          </gml:engineeringDatum>
          <originLocation>
            <PointLocation gml:id="psf-2d-origin-3" srsDimension="3"
              srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
              <gml:pos>387600.0 3742500.0 5.0</gml:pos>
            </PointLocation>
          </originLocation>
          <axisLocation>
            <AxisLocation gml:id="psf-x-axis-location-3">
              <axisRef xlink:href="#psf-x-axis-3"/>
              <axisOrder>1</axisOrder>
              <!-- Bearing 45 deg (NE) from north, same as psf-2d-crs-001. -->
              <directionVector>0.7071068 0.7071068 0.0</directionVector>
            </AxisLocation>
          </axisLocation>
          <axisLocation>
            <diggs:AxisLocation gml:id="psf-d-axis-location-3">
              <axisRef xlink:href="#psf-d-axis-3"/>
              <axisOrder>2</axisOrder>
              <!-- Fully vertical (dip 90 deg): no horizontal component, so
                   always orthogonal to any horizontal X axis. -->
              <directionVector>0.0 0.0 -1.0</directionVector>
            </diggs:AxisLocation>
          </axisLocation>
          <transformationMethod>affine</transformationMethod>
          <rotationAngle uom="dega">45.0</rotationAngle>
          <scaleFactor>1.0</scaleFactor>
          <transformationAccuracy uom="m">0.001</transformationAccuracy>
        </LocalCartesianCRS>
      </crs>
    </DocumentInformation>
  </documentInformation>

  <project>
    <Project gml:id="p1">
      <gml:name>Test Project</gml:name>
    </Project>
  </project>

  <samplingFeature>
    <PlanarSamplingFeature gml:id="psf1">
      <gml:name>PlanarSamplingFeature polygon-render test</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="psf1-refpt" srsDimension="3"
          srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>387600.0 3742700.0 5.0</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <PlanarSurface srsDimension="2" srsName="#psf-2d-crs-001" gml:id="psf1-surf">
          <gml:exterior>
            <gml:LinearRing>
              <gml:posList>
                0.0 0.0  10.0 0.0  10.0 6.0  5.0 8.0  0.0 6.0  0.0 0.0
              </gml:posList>
            </gml:LinearRing>
          </gml:exterior>
        </PlanarSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <samplingFeature>
    <PlanarSamplingFeature gml:id="psf2">
      <gml:name>PlanarSamplingFeature polygon-render test 2 (horizontal D axis)</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="psf2-refpt" srsDimension="3"
          srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>387600.0 3742600.0 5.0</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <PlanarSurface srsDimension="2" srsName="#psf-2d-crs-002" gml:id="psf2-surf">
          <gml:exterior>
            <gml:LinearRing>
              <gml:posList>
                0.0 0.0  10.0 0.0  10.0 6.0  5.0 8.0  0.0 6.0  0.0 0.0
              </gml:posList>
            </gml:LinearRing>
          </gml:exterior>
        </PlanarSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>

  <samplingFeature>
    <PlanarSamplingFeature gml:id="psf3">
      <gml:name>PlanarSamplingFeature polygon-render test 3 (vertical D axis)</gml:name>
      <projectRef xlink:href="#p1"/>
      <referencePoint>
        <PointLocation gml:id="psf3-refpt" srsDimension="3"
          srsName="https://www.opengis.net/def/crs-compound?1=http://www.opengis.net/def/crs/EPSG/0/26911&amp;2=http://www.opengis.net/def/crs/EPSG/0/5703">
          <gml:pos>387600.0 3742500.0 5.0</gml:pos>
        </PointLocation>
      </referencePoint>
      <featureExtent>
        <PlanarSurface srsDimension="2" srsName="#psf-2d-crs-003" gml:id="psf3-surf">
          <gml:exterior>
            <gml:LinearRing>
              <gml:posList>
                0.0 0.0  10.0 0.0  10.0 6.0  5.0 8.0  0.0 6.0  0.0 0.0
              </gml:posList>
            </gml:LinearRing>
          </gml:exterior>
        </PlanarSurface>
      </featureExtent>
    </PlanarSamplingFeature>
  </samplingFeature>
</Diggs>
